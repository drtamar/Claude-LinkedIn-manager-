ANTHROPIC_API_KEY=sk-ant-api03-...
SECRET_KEY=change-me-to-a-random-32-byte-string
LINKEDIN_COOKIE_SECRET=
DATABASE_URL=sqlite:///./data/linkedin_manager.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# --- Cost control (Stage A) ---------------------------------------------
# Hard monthly ceiling on paid API calls, in US dollars. On reaching it,
# cloud calls stop and local-model work carries on. Default is 10.00.
SOCIAL_DESK_MONTHLY_CAP_USD=10.00

# Override the local model picked from your hardware. Leave unset to let the
# app choose — run `python -m app.cli doctor` to see what it chose and why.
# SOCIAL_DESK_LOCAL_MODEL=qwen2.5:14b

# Where Ollama listens. Only change this if you moved it off the default.
# OLLAMA_HOST=http://127.0.0.1:11434

# --- LinkedIn, official API (Stage B) -----------------------------------
# Create a free app at https://developer.linkedin.com, add the products
# "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect",
# then run:  python -m app.cli connect-linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
# Filled in automatically by connect-linkedin. Member tokens last about 60
# days and cannot be refreshed, so re-run that command when posting 401s.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LinkedIn sunsets REST API versions periodically. Set this to a current
# YYYYMM value if posting fails complaining about the version.
# LINKEDIN_API_VERSION=202506

# --- Output -------------------------------------------------------------
# Where website articles are written, ready to import into the magazine.
# Defaults to backend/output/articles.
# SOCIAL_DESK_ARTICLE_DIR=

# Print every SQL statement. Off by default — it used to follow ENVIRONMENT,
# which meant ordinary runs buried real errors under query logs.
# SQL_ECHO=false
