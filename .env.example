# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-opus-4-8)
LINKEDIN_MANAGER_MODEL=claude-opus-4-8

# Optional: where drafts and generated artifacts are written (defaults to ./output)
LINKEDIN_MANAGER_OUTPUT_DIR=./output

# --- LinkedIn publishing (optional, only needed to auto-post) ---
# The official LinkedIn API uses OAuth 2.0. Leave blank to run in
# "local only" mode where content is generated and saved but not posted.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- LinkedIn OAuth app (only needed to run `linkedin-manager auth`) ---
# Create an app at https://www.linkedin.com/developers/apps, request the
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# products, and add your redirect URL to the app's authorized redirect URLs.
# Then run: linkedin-manager auth --write-env .env
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
