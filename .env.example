ANTHROPIC_API_KEY=sk-ant-api03-...
SECRET_KEY=change-me-to-a-random-32-byte-string
LINKEDIN_COOKIE_SECRET=
DATABASE_URL=sqlite:///./data/linkedin_manager.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# --- Cost control (Stage A) ---------------------------------------------
# Hard monthly ceiling on paid API calls, in US dollars. On reaching it,
# cloud calls stop and local-model work carries on. Default is 10.00.
SOCIAL_DESK_MONTHLY_CAP_USD=10.00

# Override the local model picked from your hardware. Leave unset to let the
# app choose — run `python -m app.cli doctor` to see what it chose and why.
# SOCIAL_DESK_LOCAL_MODEL=qwen2.5:14b

# Where Ollama listens. Only change this if you moved it off the default.
# OLLAMA_HOST=http://127.0.0.1:11434
